# ────────────────────────────────────────────────────────────
# NEXCY — Modèle de variables d'environnement
# Copier vers .env.local et renseigner les valeurs.
# ────────────────────────────────────────────────────────────

# ── Formulaire / e-mail (Resend) ──
# Clé API : https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# Expéditeur : doit appartenir à un domaine vérifié dans Resend.
RESEND_FROM_EMAIL=NEXCY <contact.agency@nexcy.fr>
RESEND_TO_EMAIL=contact.agency@nexcy.fr

# ── Anti-spam (Cloudflare Turnstile) ──
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Analytics (Plausible) ──
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=nexcy.fr

# ── URL publique du site (métadonnées, sitemap, canonical, OG) ──
NEXT_PUBLIC_SITE_URL=https://nexcy.fr

# ── Prise de rendez-vous (Cal.com) — optionnel ──
NEXT_PUBLIC_CAL_URL=

# ── Sourcing média (build/dev, serveur uniquement) — optionnel ──
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
ICONIFY_API_URL=https://api.iconify.design
