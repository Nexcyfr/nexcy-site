# ────────────────────────────────────────────────────────────
# NEXCY — Modèle de variables d'environnement
# Copier vers .env.local (développement) ou renseigner dans la plateforme de
# déploiement (production). Ne JAMAIS committer de valeur réelle.
# Détail de chaque variable : docs/DEPLOYMENT.md
# ────────────────────────────────────────────────────────────

# ── URL publique du site (canonical, sitemap, Open Graph, JSON-LD) ──
# Requise en production. Sans slash final.
NEXT_PUBLIC_SITE_URL=https://nexcy.fr

# ── Formulaire de contact : envoi des e-mails (Resend) ──
# Requises en production.
# RESEND_API_KEY      : https://resend.com/api-keys (droit « Sending access »)
# RESEND_FROM_EMAIL   : expéditeur, sur un domaine VÉRIFIÉ dans Resend (SPF/DKIM)
# RESEND_TO_EMAIL     : boîte qui reçoit les demandes
RESEND_API_KEY=
RESEND_FROM_EMAIL=NEXCY <contact.agency@nexcy.fr>
RESEND_TO_EMAIL=contact.agency@nexcy.fr

# ── Formulaire de contact : anti-robot (Cloudflare Turnstile) ──
# Requises en production. https://dash.cloudflare.com/?to=/:account/turnstile
# TURNSTILE_SECRET_KEY            : clé SECRÈTE (serveur uniquement)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY  : clé PUBLIQUE du widget (inlinée dans le build)
# Aucune de ces clés n'est nécessaire en développement local : la vérification
# est alors ignorée (jamais en production).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Mesure d'audience (Plausible, sans cookie) ── optionnel
# Domaine déclaré dans Plausible. Vide = aucun script de mesure chargé.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ── Prise de rendez-vous (Cal.com) ── optionnel
# URL publique de votre page de réservation (https uniquement), par exemple
# https://cal.com/<identifiant>/<type-d-evenement>. Vide = bloc de réservation masqué
# et aucune promesse de créneau dans les textes.
NEXT_PUBLIC_CAL_URL=

# ── Contrôle de configuration ──
# 1 = le build de production échoue si une variable requise manque.
# Activé automatiquement sur Vercel en production (VERCEL_ENV=production).
NEXCY_STRICT_ENV=
